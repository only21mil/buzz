#!/usr/bin/env bash
set -euo pipefail
set +x
umask 077

readonly launcher=/home/victor/projects/buzz/scripts/launch_buzz_desktop.sh
readonly backup=/home/victor/work/buzz-client/rollback-desktop-050ac722106c/launch_buzz_desktop.sh
readonly receipt=/home/victor/work/buzz-client/rollback-desktop-050ac722106c/receipt

[[ $# -eq 0 ]]
[[ $(id -u) -eq 1000 && $(id -un) == victor ]]
[[ -z $(pgrep -u victor -x buzz-desktop || true) ]] || {
  printf '%s\n' 'Buzz Desktop is still running' >&2
  exit 1
}
[[ -f $launcher && ! -L $launcher ]]
[[ -f $backup && ! -L $backup ]]
[[ -f $receipt && ! -L $receipt ]]
[[ $(stat -c '%U:%G:%a:%h' "$launcher") == victor:victor:700:1 ]]
[[ $(stat -c '%U:%G:%a:%h' "$backup") == victor:victor:700:1 ]]
[[ $(stat -c '%U:%G:%a:%h' "$receipt") == victor:victor:600:1 ]]
[[ $(wc -l <"$receipt") -eq 1 ]]
IFS=$'\t' read -r receipt_schema installed_hash rollback_hash extra <"$receipt"
[[ $receipt_schema == buzz-desktop-launcher-rollback-v1 && -z $extra ]]
[[ $installed_hash =~ ^[0-9a-f]{64}$ && $rollback_hash =~ ^[0-9a-f]{64}$ ]]
[[ $(sha256sum -- "$launcher" | cut -d' ' -f1) == "$installed_hash" ]]
[[ $(sha256sum -- "$backup" | cut -d' ' -f1) == "$rollback_hash" ]]

temporary=$(mktemp /home/victor/projects/buzz/scripts/.launcher-rollback.XXXXXX)
trap 'test ! -e "$temporary" || unlink "$temporary"' EXIT
install -m 0700 "$backup" "$temporary"
sync "$temporary"
mv -T "$temporary" "$launcher"
sync /home/victor/projects/buzz/scripts
[[ $(sha256sum -- "$launcher" | cut -d' ' -f1) == "$rollback_hash" ]]
printf '%s\n' ROLLED_BACK
