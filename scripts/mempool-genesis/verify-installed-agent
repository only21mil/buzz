#!/usr/bin/env bash
set -euo pipefail

slug="${1:-}"
case "$slug" in
  mempool|genesis) ;;
  *) printf '%s\n' "unsupported agent slug" >&2; exit 64 ;;
esac

closure=/etc/buzz-agents/review-closure.json
credential="${CREDENTIALS_DIRECTORY:?missing CREDENTIALS_DIRECTORY}/buzz-private-key"
expected_paths=(
  "/etc/buzz-agents/$slug.env"
  "/etc/buzz-agents/prompts/$slug.md"
  /etc/systemd/system/buzz-agent@.service
  /usr/local/libexec/buzz/run-buzz-agent
  /usr/local/libexec/buzz/verify-installed-agent
  /usr/local/libexec/buzz/buzz-agent-key-handoff
  /usr/local/libexec/buzz/export-managed-agent-key
  /usr/local/sbin/buzz-install-agent-key
  /etc/buzz-agents/enrollment-keys.json
  /etc/sudoers.d/buzz-agent-key-handoff
  /usr/local/sbin/install-enrollment-map
  /usr/local/libexec/buzz/node
  /usr/local/libexec/buzz/codex
  /usr/local/libexec/buzz/codex-acp
  /usr/local/libexec/buzz/buzz-acp
  /usr/local/libexec/buzz/buzz-dev-mcp
  /usr/lib/systemd/system/service.d/10-timeout-abort.conf
)

test -f "$closure"
test ! -L "$closure"
test "$(stat -c '%U:%G' "$closure")" = root:root
test "$(stat -c '%a' "$closure")" = 644
test "$(stat -c '%h' "$closure")" = 1

jq -e --arg slug "$slug" --argjson count "${#expected_paths[@]}" '
  .schema == "buzz-agent-review-closure-v2" and
  .accepted == true and
  (.verdict == "PASS" or .verdict == "PASS WITH RISKS") and
  (.lineage_id | type == "string" and length > 0) and
  (.state_id | type == "string" and length > 0) and
  (.runtime_artifact_fingerprint | test("^[0-9a-f]{64}$")) and
  (.candidate_fingerprint | test("^[0-9a-f]{64}$")) and
  (.bundle_digest | test("^[0-9a-f]{64}$")) and
  (.state_digest | test("^[0-9a-f]{64}$")) and
  (.verdict_digest | test("^[0-9a-f]{64}$")) and
  (.files[$slug] | type == "array" and length == $count)
' "$closure" >/dev/null

for index in "${!expected_paths[@]}"; do
  expected="${expected_paths[$index]}"
  recorded_path="$(jq -r --arg slug "$slug" --argjson index "$index" '.files[$slug][$index].path' "$closure")"
  recorded_hash="$(jq -r --arg slug "$slug" --argjson index "$index" '.files[$slug][$index].sha256' "$closure")"
  test "$recorded_path" = "$expected"
  test "$recorded_hash" = "$(sha256sum "$expected" | cut -d' ' -f1)"
  test ! -L "$expected"
  test "$(stat -c '%U:%G' "$expected")" = root:root
  test "$(stat -c '%h' "$expected")" = 1
done

test "$(stat -c '%U:%G:%a' /etc/buzz-agents)" = root:root:755
test "$(stat -c '%U:%G:%a' /etc/buzz-agents/prompts)" = root:root:755
test "$(stat -c '%U:%G:%a' /etc/buzz-agents/credentials)" = root:root:700
test "$(stat -c '%U:%G:%a' /usr/local/libexec/buzz)" = root:root:755

test "$(stat -c '%a' "/etc/buzz-agents/$slug.env")" = 644
test "$(stat -c '%a' "/etc/buzz-agents/prompts/$slug.md")" = 644
test "$(stat -c '%a' /etc/systemd/system/buzz-agent@.service)" = 644
test "$(stat -c '%a' /usr/local/libexec/buzz/run-buzz-agent)" = 755
test "$(stat -c '%a' /usr/local/libexec/buzz/verify-installed-agent)" = 755
test "$(stat -c '%a' /usr/local/libexec/buzz/buzz-agent-key-handoff)" = 755
test "$(stat -c '%a' /usr/local/libexec/buzz/export-managed-agent-key)" = 755
test "$(stat -c '%a' /usr/local/sbin/buzz-install-agent-key)" = 755
test "$(stat -c '%a' /etc/buzz-agents/enrollment-keys.json)" = 600
test "$(stat -c '%a' /etc/sudoers.d/buzz-agent-key-handoff)" = 440
test "$(stat -c '%a' /usr/local/sbin/install-enrollment-map)" = 755
test "$(stat -c '%a' /usr/local/libexec/buzz/node)" = 755
test "$(stat -c '%a' /usr/local/libexec/buzz/codex)" = 755
test "$(stat -c '%a' /usr/local/libexec/buzz/codex-acp)" = 755
test "$(stat -c '%a' /usr/local/libexec/buzz/buzz-acp)" = 755
test "$(stat -c '%a' /usr/local/libexec/buzz/buzz-dev-mcp)" = 755
test "$(stat -c '%a' /usr/lib/systemd/system/service.d/10-timeout-abort.conf)" = 644

test -f "$credential"
test ! -L "$credential"
test "$(stat -c '%h' "$credential")" = 1
test -r "$credential"
test ! -w "$credential"
test "$(wc -c < "$credential")" = 65
LC_ALL=C grep -Eq '^[0-9a-f]{64}$' "$credential"
