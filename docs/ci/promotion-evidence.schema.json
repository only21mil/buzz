{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/only21mil/buzz/docs/ci/promotion-evidence.schema.json",
  "title": "Buzz promotion acceptance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "candidate_sha",
    "base_sha",
    "tree_sha",
    "source",
    "evidence_files",
    "protected_ci",
    "tier2",
    "artifacts",
    "staging",
    "production_canary",
    "deliberate_red",
    "deployment",
    "rollback",
    "landing"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"const": "only21mil/buzz"},
    "candidate_sha": {"$ref": "#/$defs/sha40"},
    "base_sha": {"$ref": "#/$defs/sha40"},
    "tree_sha": {"$ref": "#/$defs/sha40"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkout_sha", "clean"],
      "properties": {
        "checkout_sha": {"$ref": "#/$defs/sha40"},
        "clean": {"const": true}
      }
    },
    "evidence_files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre_freeze", "protected_ci", "acceptance_verdict", "acceptance_records"],
      "properties": {
        "pre_freeze": {"$ref": "#/$defs/file_descriptor"},
        "protected_ci": {"$ref": "#/$defs/file_descriptor"},
        "acceptance_verdict": {"$ref": "#/$defs/file_descriptor"},
        "acceptance_records": {"$ref": "#/$defs/file_descriptor"},
        "collection_manifest": {"$ref": "#/$defs/file_descriptor"}
      }
    },
    "protected_ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_sha", "protected", "conclusion", "contexts"],
      "properties": {
        "head_sha": {"$ref": "#/$defs/sha40"},
        "protected": {"const": true},
        "conclusion": {"const": "success"},
        "contexts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "head_sha", "conclusion", "run_url"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "head_sha": {"$ref": "#/$defs/sha40"},
              "conclusion": {"const": "success"},
              "run_url": {"type": "string", "pattern": "^https://"}
            }
          }
        }
      }
    },
    "tier2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_commit", "checked_commit", "check_exit_code", "verdict",
        "reviewer", "model", "effort", "lineage", "state_sha256",
        "fingerprint", "prepared_at", "reviewed_at", "expires_at"
      ],
      "properties": {
        "eligible_commit": {"$ref": "#/$defs/sha40"},
        "checked_commit": {"$ref": "#/$defs/sha40"},
        "check_exit_code": {"const": 0},
        "verdict": {"enum": ["PASS", "PASS WITH RISKS"]},
        "reviewer": {"type": "string", "pattern": "^claude:"},
        "model": {"const": "claude-opus-5"},
        "effort": {"const": "high"},
        "lineage": {"type": "string", "minLength": 1},
        "state_sha256": {"$ref": "#/$defs/sha256"},
        "fingerprint": {"$ref": "#/$defs/sha256"},
        "prepared_at": {"type": "integer", "minimum": 0},
        "reviewed_at": {"type": "integer", "minimum": 0},
        "expires_at": {"type": "integer", "minimum": 0}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_ref", "image_ids", "running_image_id", "binary_sha256",
        "oci_revision", "required_migration", "database_migration"
      ],
      "properties": {
        "image_ref": {"type": "string", "minLength": 1},
        "image_ids": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/image_id"}},
        "running_image_id": {"$ref": "#/$defs/image_id"},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "oci_revision": {"$ref": "#/$defs/sha40"},
        "required_migration": {"type": "integer", "minimum": 0},
        "database_migration": {"type": "integer", "minimum": 0}
      }
    },
    "staging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_sha", "absent_policy_status", "configured_policy_status", "root_executor_handoff",
        "advertised_bounds_sha256", "enforced_bounds_sha256", "scenarios",
        "event_evidence", "log"
      ],
      "properties": {
        "candidate_sha": {"$ref": "#/$defs/sha40"},
        "absent_policy_status": {"const": 503},
        "configured_policy_status": {"const": 200},
        "root_executor_handoff": {"const": true},
        "advertised_bounds_sha256": {"$ref": "#/$defs/sha256"},
        "enforced_bounds_sha256": {"$ref": "#/$defs/sha256"},
        "scenarios": {
          "type": "object",
          "additionalProperties": false,
          "required": ["success", "policy_refusal", "teardown_failure", "restart_recovery", "unaccepted_refusal"],
          "properties": {
            "success": {"const": "PASS"},
            "policy_refusal": {"const": "PASS"},
            "teardown_failure": {"const": "PASS"},
            "restart_recovery": {"const": "PASS"},
            "unaccepted_refusal": {"const": "PASS"}
          }
        },
        "event_evidence": {"$ref": "#/$defs/signed_ci_event_evidence"},
        "log": {"$ref": "#/$defs/log_auth"}
      }
    },
    "production_canary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_sha", "accepted_executed", "unaccepted_refused", "event_evidence", "retry"
      ],
      "properties": {
        "candidate_sha": {"$ref": "#/$defs/sha40"},
        "accepted_executed": {"const": true},
        "unaccepted_refused": {"const": true},
        "event_evidence": {"$ref": "#/$defs/signed_ci_event_evidence"},
        "retry": {"$ref": "#/$defs/retry"}
      }
    },
    "deliberate_red": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_sha", "red_sha", "accepted_commit", "required_check",
        "conclusion", "merge_allowed", "protected_rule", "terminal_events",
        "first_run_id", "duplicate_run_id", "parity", "event_evidence"
      ],
      "properties": {
        "system_sha": {"$ref": "#/$defs/sha40"},
        "red_sha": {"$ref": "#/$defs/sha40"},
        "accepted_commit": {"const": true},
        "required_check": {"type": "string", "minLength": 1},
        "conclusion": {"const": "failure"},
        "merge_allowed": {"const": false},
        "protected_rule": {"const": true},
        "terminal_events": {"const": 1},
        "first_run_id": {"type": "string", "minLength": 1},
        "duplicate_run_id": {"type": "string", "minLength": 1},
        "parity": {"$ref": "#/$defs/ci_parity"},
        "event_evidence": {"$ref": "#/$defs/signed_ci_event_evidence"}
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha", "image_ref", "running_image_id", "binary_sha256",
        "oci_revision", "database_migration", "dump_before_swap", "dump_sha256",
        "readiness", "nip11", "started_at", "swapped_at", "finished_at", "log"
      ],
      "properties": {
        "commit_sha": {"$ref": "#/$defs/sha40"},
        "image_ref": {"type": "string", "minLength": 1},
        "running_image_id": {"$ref": "#/$defs/image_id"},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "oci_revision": {"$ref": "#/$defs/sha40"},
        "database_migration": {"type": "integer", "minimum": 0},
        "dump_before_swap": {"const": true},
        "dump_sha256": {"$ref": "#/$defs/sha256"},
        "readiness": {"const": true},
        "nip11": {"const": true},
        "started_at": {"type": "integer", "minimum": 0},
        "swapped_at": {"type": "integer", "minimum": 0},
        "finished_at": {"type": "integer", "minimum": 0},
        "log": {"$ref": "#/$defs/log_auth"}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatible", "advanced"],
      "properties": {
        "compatible": {"$ref": "#/$defs/compatible_rollback"},
        "advanced": {"$ref": "#/$defs/advanced_rollback"}
      }
    },
    "landing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relay_sha", "mirror_sha", "merge_sha"],
      "properties": {
        "relay_sha": {"$ref": "#/$defs/sha40"},
        "mirror_sha": {"$ref": "#/$defs/sha40"},
        "merge_sha": {"$ref": "#/$defs/sha40"}
      }
    }
  },
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sig128": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
    "uuid": {"type": "string", "format": "uuid"},
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9_]{1,64}$"},
    "image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "file_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "ci_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_repo_a", "workflow_id", "workflow_digest", "job_ids", "relay_signer"],
      "properties": {
        "target_repo_a": {"type": "string", "minLength": 1},
        "workflow_id": {"type": "string", "minLength": 1},
        "workflow_digest": {"$ref": "#/$defs/sha256"},
        "job_ids": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/job_id"}},
        "relay_signer": {"$ref": "#/$defs/sha256"}
      }
    },
    "signed_ci_event_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id", "relay_url", "authorized_relay_signers", "requests", "events", "decoded_logs"
      ],
      "properties": {
        "channel_id": {"$ref": "#/$defs/uuid"},
        "relay_url": {"type": "string", "pattern": "^https?://[^/?#]+$"},
        "authorized_relay_signers": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "requests": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/signed_ci_request"}
        },
        "events": {
          "type": "array", "minItems": 10,
          "items": {"$ref": "#/$defs/signed_ci_event"}
        },
        "decoded_logs": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/sha256"},
          "additionalProperties": {"type": "string", "contentEncoding": "base64"}
        }
      }
    },
    "signed_ci_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pubkey", "created_at", "kind", "tags", "content", "sig", "stored"],
      "properties": {
        "kind": {"const": 46100},
        "id": {"$ref": "#/$defs/sha256"},
        "pubkey": {"$ref": "#/$defs/sha256"},
        "created_at": {"type": "integer", "minimum": 0},
        "tags": {"$ref": "#/$defs/nostr_tags"},
        "sig": {"$ref": "#/$defs/sig128"},
        "stored": {"const": true},
        "content": {"type": "string", "minLength": 1}
      }
    },
    "signed_ci_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "pubkey", "created_at", "kind", "tags", "content", "sig", "stored", "watch_cursor"
      ],
      "properties": {
        "kind": {"enum": [46101, 46102, 46103, 46104, 46105, 46106]},
        "id": {"$ref": "#/$defs/sha256"},
        "pubkey": {"$ref": "#/$defs/sha256"},
        "created_at": {"type": "integer", "minimum": 0},
        "tags": {"$ref": "#/$defs/nostr_tags"},
        "sig": {"$ref": "#/$defs/sig128"},
        "stored": {"const": true},
        "watch_cursor": {"type": "integer", "minimum": 1},
        "content": {"type": "string", "minLength": 1}
      }
    },
    "nostr_tags": {
      "type": "array",
      "items": {
        "type": "array", "minItems": 1,
        "items": {"type": "string"}
      }
    },
    "ci_request_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "request_type", "target_repo_a", "pr_root_event_id",
        "source_clone_url", "immutable_source_ref", "tip_oid", "source_branch", "base_ref",
        "base_oid", "workflow_id", "workflow_digest", "job_ids", "run_id", "attempt",
        "trigger_event_id", "actor", "timeout_seconds", "idempotency_key", "issued_at", "expires_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "request_type": {"const": "run"},
        "target_repo_a": {"type": "string", "minLength": 1},
        "pr_root_event_id": {"$ref": "#/$defs/sha256"},
        "pr_update_event_id": {"$ref": "#/$defs/sha256"},
        "source_clone_url": {"type": "string", "minLength": 1},
        "immutable_source_ref": {"type": "string", "minLength": 1},
        "tip_oid": {"$ref": "#/$defs/sha40"},
        "source_branch": {"type": "string", "minLength": 1},
        "base_ref": {"type": "string", "minLength": 1},
        "base_oid": {"$ref": "#/$defs/sha40"},
        "workflow_id": {"type": "string", "minLength": 1},
        "workflow_digest": {"$ref": "#/$defs/sha256"},
        "job_ids": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/job_id"}},
        "run_id": {"$ref": "#/$defs/uuid"},
        "attempt": {"const": 1},
        "trigger_event_id": {"$ref": "#/$defs/sha256"},
        "actor": {"$ref": "#/$defs/sha256"},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "idempotency_key": {"type": "string", "minLength": 1},
        "issued_at": {"type": "integer", "minimum": 0},
        "expires_at": {"type": "integer", "minimum": 1}
      }
    },
    "run_status_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "request_event_id", "run_id", "workflow_id", "target_repo_a",
        "tip_oid", "base_oid", "attempt", "sequence", "state", "job_ids", "relay_signer"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "request_event_id": {"$ref": "#/$defs/sha256"},
        "run_id": {"type": "string", "minLength": 1},
        "workflow_id": {"type": "string", "minLength": 1},
        "target_repo_a": {"type": "string", "minLength": 1},
        "tip_oid": {"$ref": "#/$defs/sha40"},
        "base_oid": {"$ref": "#/$defs/sha40"},
        "attempt": {"type": "integer", "minimum": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "state": {"enum": ["queued", "running", "success", "failure", "cancelled", "timed_out", "infrastructure_failure"]},
        "conclusion": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "started_at": {"type": "integer", "minimum": 0},
        "finished_at": {"type": "integer", "minimum": 0},
        "job_ids": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/job_id"}},
        "relay_signer": {"$ref": "#/$defs/sha256"}
      }
    },
    "job_status_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "request_event_id", "run_id", "workflow_id", "target_repo_a",
        "tip_oid", "base_oid", "job_id", "name", "attempt", "sequence", "state",
        "required", "skip_policy", "selected_job_instance", "also_reruns", "artifact_refs", "relay_signer"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "request_event_id": {"$ref": "#/$defs/sha256"},
        "run_id": {"type": "string", "minLength": 1},
        "workflow_id": {"type": "string", "minLength": 1},
        "target_repo_a": {"type": "string", "minLength": 1},
        "tip_oid": {"$ref": "#/$defs/sha40"},
        "base_oid": {"$ref": "#/$defs/sha40"},
        "job_id": {"$ref": "#/$defs/job_id"},
        "name": {"type": "string", "minLength": 1},
        "attempt": {"type": "integer", "minimum": 1},
        "parent_attempt": {"type": "integer", "minimum": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "state": {"enum": ["queued", "running", "success", "failure", "cancelled", "timed_out", "skipped"]},
        "conclusion": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "skip_policy": {"enum": ["allow", "forbid"]},
        "selected_job_instance": {},
        "also_reruns": {"type": "array"},
        "started_at": {"type": "integer", "minimum": 0},
        "finished_at": {"type": "integer", "minimum": 0},
        "log_ref": {"$ref": "#/$defs/sha256"},
        "artifact_refs": {"type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}},
        "relay_signer": {"$ref": "#/$defs/sha256"}
      }
    },
    "log_reference_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "request_event_id", "run_id", "workflow_id", "target_repo_a",
        "tip_oid", "job_id", "attempt", "log_sha256", "byte_length", "cap_bytes",
        "truncated", "created_at", "relay_signer"
      ],
      "properties": {
        "schema_version": {"const": 1}, "request_event_id": {"$ref": "#/$defs/sha256"},
        "run_id": {"type": "string", "minLength": 1}, "workflow_id": {"type": "string", "minLength": 1},
        "target_repo_a": {"type": "string", "minLength": 1}, "tip_oid": {"$ref": "#/$defs/sha40"},
        "job_id": {"$ref": "#/$defs/job_id"}, "attempt": {"type": "integer", "minimum": 1},
        "log_sha256": {"$ref": "#/$defs/sha256"}, "byte_length": {"type": "integer", "minimum": 1},
        "cap_bytes": {"type": "integer", "minimum": 1}, "truncated": {"const": false},
        "url": {"type": "string", "pattern": "^https?://"}, "inline": {"type": "string", "minLength": 1},
        "created_at": {"type": "integer", "minimum": 0}, "relay_signer": {"$ref": "#/$defs/sha256"}
      },
      "oneOf": [{"required": ["url"]}, {"required": ["inline"]}]
    },
    "artifact_reference_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "request_event_id", "run_id", "workflow_id", "target_repo_a", "tip_oid",
        "job_id", "attempt", "artifact_id", "name", "media_type", "sha256", "byte_length", "url",
        "created_at", "relay_signer"
      ],
      "properties": {
        "schema_version": {"const": 1}, "request_event_id": {"$ref": "#/$defs/sha256"},
        "run_id": {"type": "string", "minLength": 1}, "workflow_id": {"type": "string", "minLength": 1},
        "target_repo_a": {"type": "string", "minLength": 1}, "tip_oid": {"$ref": "#/$defs/sha40"},
        "job_id": {"$ref": "#/$defs/job_id"}, "attempt": {"type": "integer", "minimum": 1},
        "artifact_id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 1}, "url": {"type": "string", "pattern": "^https?://"},
        "created_at": {"type": "integer", "minimum": 0}, "relay_signer": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence_finalized_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "request_event_id", "run_id", "workflow_id", "target_repo_a", "tip_oid",
        "attempt", "finalized_job_attempts", "finalized_at", "relay_signer"
      ],
      "properties": {
        "schema_version": {"const": 1}, "request_event_id": {"$ref": "#/$defs/sha256"},
        "run_id": {"type": "string", "minLength": 1}, "workflow_id": {"type": "string", "minLength": 1},
        "target_repo_a": {"type": "string", "minLength": 1}, "tip_oid": {"$ref": "#/$defs/sha40"},
        "attempt": {"type": "integer", "minimum": 1},
        "finalized_job_attempts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/finalized_job_attempt"}},
        "finalized_at": {"type": "integer", "minimum": 0}, "relay_signer": {"$ref": "#/$defs/sha256"}
      }
    },
    "finalized_job_attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "attempt", "log_ref", "artifact_refs"],
      "properties": {
        "job_id": {"$ref": "#/$defs/job_id"}, "attempt": {"type": "integer", "minimum": 1},
        "log_ref": {"$ref": "#/$defs/sha256"},
        "artifact_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}
      }
    },
    "teardown_attestation_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "request_event_id", "run_id", "workflow_id", "target_repo_a", "tip_oid",
        "base_oid", "workflow_digest", "attempt", "leases", "lease_empty", "teardown_at", "relay_signer"
      ],
      "properties": {
        "schema_version": {"const": 1}, "request_event_id": {"$ref": "#/$defs/sha256"},
        "run_id": {"type": "string", "minLength": 1}, "workflow_id": {"type": "string", "minLength": 1},
        "target_repo_a": {"type": "string", "minLength": 1}, "tip_oid": {"$ref": "#/$defs/sha40"},
        "base_oid": {"$ref": "#/$defs/sha40"}, "workflow_digest": {"$ref": "#/$defs/sha256"},
        "attempt": {"type": "integer", "minimum": 1},
        "leases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lease"}},
        "lease_empty": {"const": true}, "teardown_at": {"type": "integer", "minimum": 0},
        "relay_signer": {"$ref": "#/$defs/sha256"}
      }
    },
    "lease": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "attempt", "lease_id"],
      "properties": {
        "job_id": {"$ref": "#/$defs/job_id"}, "attempt": {"type": "integer", "minimum": 1},
        "lease_id": {"type": "string", "minLength": 1}
      }
    },
    "log_auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized_status", "unauthorized_status", "redirects", "sha256",
        "computed_sha256", "byte_count", "byte_cap"
      ],
      "properties": {
        "authorized_status": {"const": 200},
        "unauthorized_status": {"enum": [401, 403]},
        "redirects": {"const": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "computed_sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1},
        "byte_cap": {"type": "integer", "minimum": 1}
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id", "rerun_request_id", "first_run_id", "duplicate_run_id", "attempts",
        "workspaces", "terminal_events"
      ],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "rerun_request_id": {"$ref": "#/$defs/sha256"},
        "first_run_id": {"$ref": "#/$defs/uuid"},
        "duplicate_run_id": {"$ref": "#/$defs/uuid"},
        "attempts": {"const": [1, 2]},
        "workspaces": {"type": "array", "minItems": 2, "maxItems": 2,
          "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "terminal_events": {"const": 1}
      }
    },
    "compatible_rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "current_migration", "prior_required_migration", "prior_image_id",
        "prior_binary_sha256", "prior_dump_sha256", "restore_attempted", "restored_image_id",
        "restored_binary_sha256", "restored_dump_sha256", "readiness", "nip11"
      ],
      "properties": {
        "mode": {"const": "restored"},
        "current_migration": {"type": "integer", "minimum": 0},
        "prior_required_migration": {"type": "integer", "minimum": 0},
        "prior_image_id": {"$ref": "#/$defs/image_id"},
        "prior_binary_sha256": {"$ref": "#/$defs/sha256"},
        "prior_dump_sha256": {"$ref": "#/$defs/sha256"},
        "restore_attempted": {"const": true},
        "restored_image_id": {"$ref": "#/$defs/image_id"},
        "restored_binary_sha256": {"$ref": "#/$defs/sha256"},
        "restored_dump_sha256": {"$ref": "#/$defs/sha256"},
        "readiness": {"const": true},
        "nip11": {"const": true}
      }
    },
    "advanced_rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "current_migration", "prior_required_migration", "restore_attempted", "reason"],
      "properties": {
        "mode": {"const": "refused"},
        "current_migration": {"type": "integer", "minimum": 0},
        "prior_required_migration": {"type": "integer", "minimum": 0},
        "restore_attempted": {"const": false},
        "reason": {"const": "migration_advanced"}
      }
    }
  }
}
