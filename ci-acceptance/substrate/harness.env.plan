BUZZ_CI_EXECD_SOCKET=/run/buzzci/execd.sock
BUZZ_CI_BROKER_UNIT=buzz-ci-execd.service
BUZZ_CI_LEASE_STATE_ROOT=/var/lib/buzzci/leases
BUZZ_CI_RUNNER_CTL=/usr/libexec/buzz-ci-runner
BUZZ_CI_ACCEPTANCE_CTL=/usr/libexec/buzz-ci-acceptance-ctl
BUZZ_CI_QUALIFICATION_CASE_ROOT=/etc/buzzci/qualification-cases
BUZZ_CI_FIXTURE_REPO=@ABSOLUTE_FIXTURE_REPOSITORY@
BUZZ_CI_HARNESS_SIGNER=@LOWERCASE_64_HEX_PUBLIC_KEY@
BUZZ_CI_GRAPH_REDUCER=/usr/libexec/buzz-ci-graph-reducer
BUZZ_CI_GRAPH_FIXTURE_DIR=/usr/share/buzzci/ci-graph-fixtures
