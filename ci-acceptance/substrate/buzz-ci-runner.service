[Unit]
Description=Buzz CI unprivileged runner
Requires=buzz-ci-execd.socket systemd-tmpfiles-setup.service
After=local-fs.target buzz-ci-execd.socket systemd-tmpfiles-setup.service

[Service]
Type=exec
User=buzzci-ctl
Group=buzzci-ctl
UMask=0077
ExecStart=/usr/libexec/buzz-ci-runner --config /etc/buzzci/runner-v1.json
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/buzzci/runner-v1.json /run/buzzci
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
Restart=no
