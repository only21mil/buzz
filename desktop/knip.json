{
  "entry": [
    "src/main.tsx",
    "src/app/routes.ts",
    "src/app/routes/**/*.{ts,tsx}",
    "src/**/*.test.mjs",
    "src/**/*.typecheck.ts",
    "src/platform/web/shims/*.ts",
    "src/testing/e2eBridge*.ts",
    "scripts/**/*.mjs",
    "tests/**/*.{ts,mjs}",
    "test-loader*.mjs",
