{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "additionalProperties":false,
  "properties":{
    "capacity":{"enum":[0,1]},
    "enabled_protocol":{"const":2},
    "executor":{"$ref":"#/$defs/program"},
    "identities":{"$ref":"#/$defs/identities"},
    "lane_manifest":{"type":"object"},
    "lane_manifest_digest":{"$ref":"#/$defs/sha256"},
    "paths":{"$ref":"#/$defs/paths"},
    "qualification":{"$ref":"#/$defs/qualification"},
    "schema_version":{"const":2}
  },
  "required":["schema_version","enabled_protocol","capacity","identities","paths","lane_manifest","lane_manifest_digest","executor","qualification"],
  "type":"object",
  "$defs":{
    "identities":{
      "additionalProperties":false,
      "properties":{
        "access_group":{"const":"buzzci-execd"},
        "access_group_gid":{"type":"integer","minimum":1,"maximum":4294967295},
        "access_group_members":{"const":["buzzci-ctl","buzzci-runner"]},
        "control_gid":{"type":"integer","minimum":1,"maximum":4294967295},
        "control_group":{"const":"buzzci-ctl"},
        "control_home":{"const":"/var/lib/buzzci/ctl"},
        "control_shell":{"const":"/usr/sbin/nologin"},
        "control_supplementary_groups":{"const":["buzzci-execd"]},
        "control_uid":{"type":"integer","minimum":1,"maximum":4294967295},
        "control_user":{"const":"buzzci-ctl"},
        "execd_gid":{"const":0},
        "execd_uid":{"const":0},
        "job_gid":{"type":"integer","minimum":1,"maximum":4294967295},
        "job_uid":{"type":"integer","minimum":1,"maximum":4294967295},
        "runner_gid":{"type":"integer","minimum":1,"maximum":4294967295},
        "runner_uid":{"type":"integer","minimum":1,"maximum":4294967295}
      },
      "required":["execd_uid","execd_gid","runner_uid","runner_gid","control_uid","control_gid","control_user","control_group","control_home","control_shell","control_supplementary_groups","job_uid","job_gid","access_group","access_group_gid","access_group_members"],
      "type":"object"
    },
    "paths":{
      "additionalProperties":false,
      "properties":{
        "binding_root":{"const":"/var/lib/buzzci/execd-v2/bindings"},
        "evidence_root":{"const":"/var/lib/buzzci/execd-v2/evidence"},
        "executor_socket":{"const":"/run/buzzci/executor.sock"},
        "intent_root":{"const":"/var/lib/buzzci/execd-v2/intents"},
        "teardown_root":{"const":"/var/lib/buzzci/execd-v2/teardown"},
        "attempt_root":{"const":"/var/lib/buzzci/execd-v2/attempts"},
        "qualification_root":{"const":"/var/lib/buzzci/execd-v2/qualification"}
      },
      "required":["intent_root","binding_root","evidence_root","teardown_root","attempt_root","qualification_root","executor_socket"],
      "type":"object"
    },
    "program":{
      "additionalProperties":false,
      "properties":{
        "gid":{"const":0},
        "mode":{"const":493},
        "path":{"const":"/usr/libexec/buzz-ci-executor"},
        "sha256":{"$ref":"#/$defs/sha256"},
        "source_commit":{"pattern":"^[0-9a-f]{40}$","type":"string"},
        "uid":{"const":0}
      },
      "required":["path","sha256","source_commit","uid","gid","mode"],
      "type":"object"
    },
    "qualification":{
      "additionalProperties":false,
      "properties":{
        "activation_package_digest":{"$ref":"#/$defs/sha256"},
        "controller_generation":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "fixture_digest":{"$ref":"#/$defs/sha256"},
        "integrated_candidate_sha":{"pattern":"^[0-9a-f]{40}$","type":"string"},
        "runner_generation":{"type":"integer","minimum":1,"maximum":9007199254740991}
      },
      "required":["integrated_candidate_sha","activation_package_digest","fixture_digest","controller_generation","runner_generation"],
      "type":"object"
    },
    "sha256":{"pattern":"^[0-9a-f]{64}$","type":"string"}
  }
}
