[Unit]
Description=Buzz CI privileged execution broker
Requires=buzz-ci-execd.socket buzz-ci-executor.socket
After=buzz-ci-executor.socket

[Service]
Type=simple
ExecStart=/usr/libexec/buzz-ci-execd --socket-activation
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ReadOnlyPaths=/etc/buzzci/execd-v2.json /usr/libexec/buzz-ci-executor /usr/libexec/buzz-ci-capacity-one-fixture /usr/share/buzzci/execd-v2/fixture /usr/share/containers/seccomp.json
ReadWritePaths=/var/lib/buzzci/execd-v2 /var/lib/buzzci/seccomp /var/lib/buzzci/activation/receipts
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
# Materialization creates the job-owned attempt tree as root: CAP_CHOWN for the
# fchown to buzzci-job, CAP_FOWNER for the fchmod of inodes it no longer owns,
# CAP_DAC_OVERRIDE to create, read, and remove inside those job-owned 0500/0700
# trees. Nothing else; ProtectSystem=strict and ReadWritePaths bound the writes.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
AmbientCapabilities=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @raw-io @reboot @swap
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=buzz-ci-capacity-one.target
