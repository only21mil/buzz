[Unit]
Description=Buzz CI capacity-one control daemon
Documentation=file:/usr/share/doc/buzz-ci-controld/README.md
Requires=systemd-tmpfiles-setup.service
After=local-fs.target systemd-tmpfiles-setup.service

[Service]
Type=exec
User=buzzci-controld
Group=buzzci-controld
UMask=0077
ExecStart=/usr/libexec/buzz-ci-controld /etc/buzzci/controld-v2.json
NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=no
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
# /run/buzzci is listed as a directory, never as its socket inodes: SELinux
# denies init_t mounton on a sock_file, so a per-socket ReadOnlyPaths entry
# fails the unit at NAMESPACE once the keyholder or runner socket exists.
ReadOnlyPaths=/etc/buzzci/controld-v2.json /run/buzzci -/var/lib/buzzci/activation-controller/controld-acceptance-v2.json
ReadWritePaths=/var/lib/buzzci/controld
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
Restart=on-failure
RestartSec=5s
