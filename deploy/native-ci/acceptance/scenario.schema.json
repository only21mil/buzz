{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buzz.dev/schemas/native-ci/capacity-one-scenario-v2.json",
  "title": "Buzz native CI capacity-one acceptance scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture", "driver"],
  "properties": {
    "schema_version": {
      "const": "buzz-ci-capacity-one-scenario/v2"
    },
    "fixture": {
      "$ref": "#/$defs/fixture"
    },
    "driver": {
      "$ref": "#/$defs/driver"
    }
  },
  "$defs": {
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "not": { "pattern": "^0+$" }
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "not": { "pattern": "^0+$" }
    },
    "gitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "not": { "pattern": "^0+$" }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "bytes"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/\\\\]+$"
        },
        "sha256": { "$ref": "#/$defs/hex64" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integrated_candidate_sha",
        "activation_id",
        "activation_package_digest",
        "run_id",
        "job_id",
        "request_digest",
        "manifest_digest",
        "source_oid",
        "approval_id",
        "grant_event_id",
        "grant_digest",
        "approved_by",
        "export_subject",
        "export_authorization_digest",
        "controller_generation",
        "runner_generation",
        "expected_log",
        "expected_artifacts"
      ],
      "properties": {
        "integrated_candidate_sha": { "$ref": "#/$defs/gitOid" },
        "activation_id": {
          "type": "string",
          "pattern": "^buzz-ci-capacity-one-[0-9a-f]{12}-[0-9a-f]{12}$"
        },
        "activation_package_digest": { "$ref": "#/$defs/hex64" },
        "run_id": { "$ref": "#/$defs/hex32" },
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "request_digest": { "$ref": "#/$defs/hex64" },
        "manifest_digest": { "$ref": "#/$defs/hex64" },
        "source_oid": { "$ref": "#/$defs/gitOid" },
        "approval_id": { "$ref": "#/$defs/hex32" },
        "grant_event_id": { "$ref": "#/$defs/hex64" },
        "grant_digest": { "$ref": "#/$defs/hex64" },
        "approved_by": { "$ref": "#/$defs/hex64" },
        "export_subject": { "$ref": "#/$defs/hex64" },
        "export_authorization_digest": { "$ref": "#/$defs/hex64" },
        "controller_generation": { "type": "integer", "minimum": 1 },
        "runner_generation": { "type": "integer", "minimum": 1 },
        "expected_log": { "$ref": "#/$defs/evidence" },
        "expected_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program"],
      "properties": {
        "program": {
          "const": "/usr/libexec/buzz-ci-capacity-one-driver"
        },
        "args": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "observe",
        "export",
        "controller_process",
        "runner_process",
        "timeout_seconds"
      ],
      "properties": {
        "control": { "$ref": "#/$defs/endpoint" },
        "observe": { "$ref": "#/$defs/endpoint" },
        "export": { "$ref": "#/$defs/endpoint" },
        "controller_process": { "$ref": "#/$defs/endpoint" },
        "runner_process": { "$ref": "#/$defs/endpoint" },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      }
    }
  }
}
