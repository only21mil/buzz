{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buzz.dev/schemas/native-ci/capacity-one-acceptance-receipt-v2.json",
  "title": "Buzz native CI capacity-one acceptance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "outcome", "scenario_sha256", "integrated_candidate_sha", "run_id", "checks"],
  "properties": {
    "schema_version": { "const": "buzz-ci-capacity-one-acceptance-receipt/v2" },
    "outcome": { "$ref": "#/$defs/outcome" },
    "scenario_sha256": { "$ref": "#/$defs/hex64" },
    "integrated_candidate_sha": { "$ref": "#/$defs/gitOid" },
    "run_id": { "$ref": "#/$defs/hex32" },
    "checks": {
      "type": "array",
      "maxItems": 13,
      "prefixItems": [
        { "$ref": "#/$defs/check1" }, { "$ref": "#/$defs/check2" },
        { "$ref": "#/$defs/check3" }, { "$ref": "#/$defs/check4" },
        { "$ref": "#/$defs/check5" }, { "$ref": "#/$defs/check6" },
        { "$ref": "#/$defs/check7" }, { "$ref": "#/$defs/check8" },
        { "$ref": "#/$defs/check9" }, { "$ref": "#/$defs/check10" },
        { "$ref": "#/$defs/check11" }, { "$ref": "#/$defs/check12" },
        { "$ref": "#/$defs/check13" }
      ],
      "items": false
    },
    "zero_transition": { "$ref": "#/$defs/zeroTransition" },
    "failure": { "$ref": "#/$defs/failure" }
  },
  "allOf": [{
    "if": { "properties": { "outcome": { "const": "pass" } }, "required": ["outcome"] },
      "then": {
      "required": ["zero_transition"],
      "properties": {
        "checks": { "minItems": 13, "maxItems": 13 },
        "zero_transition": { "$ref": "#/$defs/passZeroTransition" }
      },
        "allOf": [
          { "not": { "required": ["failure"] } },
          {
            "not": {
              "properties": {
                "checks": {
                  "contains": {
                    "properties": { "outcome": { "const": "fail" } },
                    "required": ["outcome"]
                  }
                }
              },
              "required": ["checks"]
            }
          }
        ]
    },
    "else": { "required": ["failure"] }
  }],
  "$defs": {
    "outcome": { "enum": ["pass", "fail"] },
    "hex32": { "type": "string", "pattern": "^[0-9a-f]{32}$", "not": { "pattern": "^0+$" } },
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$", "not": { "pattern": "^0+$" } },
    "gitOid": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$", "not": { "pattern": "^0+$" } },
    "stage": {
      "enum": [
        "capacity_zero_closed", "capacity_one_open", "manifest_identity",
        "approval_grant", "grant_resume", "first_attempt_terminal",
        "authenticated_export", "rerun_separation", "cancellation_terminal",
        "tombstone_folding", "controller_restart_recovery",
        "runner_restart_recovery", "prepare_capacity_zero"
      ]
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "sha256", "bytes"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\]+$" },
        "sha256": { "$ref": "#/$defs/hex64" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["approval_id", "grant_event_id", "grant_digest", "approved_by", "resumed"],
      "properties": {
        "approval_id": { "$ref": "#/$defs/hex32" },
        "grant_event_id": { "$ref": "#/$defs/hex64" },
        "grant_digest": { "$ref": "#/$defs/hex64" },
        "approved_by": { "$ref": "#/$defs/hex64" },
        "resumed": { "type": "boolean" }
      }
    },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "attempt", "state", "conclusion", "integrated_candidate_sha", "request_digest", "manifest_digest", "source_oid", "artifacts"],
      "properties": {
        "attempt_id": { "$ref": "#/$defs/hex32" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 2 },
        "parent_attempt_id": { "$ref": "#/$defs/hex32" },
        "state": { "enum": ["queued", "running", "terminal", "tombstoned"] },
        "conclusion": { "enum": ["none", "success", "failure", "cancelled", "timed_out", "infrastructure_failure"] },
        "integrated_candidate_sha": { "$ref": "#/$defs/gitOid" },
        "request_digest": { "$ref": "#/$defs/hex64" },
        "manifest_digest": { "$ref": "#/$defs/hex64" },
        "source_oid": { "$ref": "#/$defs/gitOid" },
        "evidence_set_digest": { "$ref": "#/$defs/hex64" },
        "log": { "$ref": "#/$defs/evidence" },
        "artifacts": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "integrated_candidate_sha", "request_digest", "manifest_digest", "source_oid", "state", "aggregate_conclusion", "attempts"],
      "properties": {
        "run_id": { "$ref": "#/$defs/hex32" },
        "integrated_candidate_sha": { "$ref": "#/$defs/gitOid" },
        "request_digest": { "$ref": "#/$defs/hex64" },
        "manifest_digest": { "$ref": "#/$defs/hex64" },
        "source_oid": { "$ref": "#/$defs/gitOid" },
        "state": { "enum": ["awaiting_approval", "granted_awaiting_resume", "running", "terminal"] },
        "aggregate_conclusion": { "enum": ["none", "success", "failure", "cancelled", "timed_out", "infrastructure_failure"] },
        "approval": { "$ref": "#/$defs/approval" },
        "selected_attempt_id": { "$ref": "#/$defs/hex32" },
        "attempts": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/attempt" } }
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["capacity", "admission", "active_run_count", "active_attempt_count", "controller_generation", "runner_generation"],
      "properties": {
        "capacity": { "type": "integer", "minimum": 0, "maximum": 1 },
        "admission": { "enum": ["closed", "open"] },
        "active_run_count": { "type": "integer", "minimum": 0, "maximum": 1 },
        "active_attempt_count": { "type": "integer", "minimum": 0, "maximum": 1 },
        "controller_generation": { "type": "integer", "minimum": 1 },
        "runner_generation": { "type": "integer", "minimum": 1 },
        "run": { "$ref": "#/$defs/run" }
      }
    },
    "export": {
      "type": "object", "additionalProperties": false,
      "required": ["authenticated", "subject", "authorization_digest", "attempt_id", "request_digest", "manifest_digest", "evidence_set_digest", "objects"],
      "properties": {
        "authenticated": { "const": true },
        "subject": { "$ref": "#/$defs/hex64" },
        "authorization_digest": { "$ref": "#/$defs/hex64" },
        "attempt_id": { "$ref": "#/$defs/hex32" },
        "request_digest": { "$ref": "#/$defs/hex64" },
        "manifest_digest": { "$ref": "#/$defs/hex64" },
        "evidence_set_digest": { "$ref": "#/$defs/hex64" },
        "objects": { "type": "array", "minItems": 1, "maxItems": 65, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "stage", "outcome", "evidence_sha256", "snapshot"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 13 },
        "stage": { "$ref": "#/$defs/stage" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "evidence_sha256": { "$ref": "#/$defs/hex64" },
        "snapshot": { "$ref": "#/$defs/snapshot" },
        "export": { "$ref": "#/$defs/export" }
      }
    },
    "check1": { "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "sequence": { "const": 1 }, "stage": { "const": "capacity_zero_closed" } } }, { "not": { "required": ["export"] } }] },
    "check2": { "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "sequence": { "const": 2 }, "stage": { "const": "capacity_one_open" } } }, { "not": { "required": ["export"] } }] },
    "check3": { "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "sequence": { "const": 3 }, "stage": { "const": "manifest_identity" } } }, { "not": { "required": ["export"] } }] },
    "check4": { "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "sequence": { "const": 4 }, "stage": { "const": "approval_grant" } } }, { "not": { "required": ["export"] } }] },
    "check5": { "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "sequence": { "const": 5 }, "stage": { "const": "grant_resume" } } }, { "not": { "required": ["export"] } }] },
    "check6": { "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "sequence": { "const": 6 }, "stage": { "const": "first_attempt_terminal" } } }, { "not": { "required": ["export"] } }] },
    "check7": { "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "sequence": { "const": 7 }, "stage": { "const": "authenticated_export" } }, "required": ["export"] }] },
    "check8": { "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "sequence": { "const": 8 }, "stage": { "const": "rerun_separation" } } }, { "not": { "required": ["export"] } }] },
    "check9": { "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "sequence": { "const": 9 }, "stage": { "const": "cancellation_terminal" } } }, { "not": { "required": ["export"] } }] },
    "check10": { "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "sequence": { "const": 10 }, "stage": { "const": "tombstone_folding" } } }, { "not": { "required": ["export"] } }] },
    "check11": { "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "sequence": { "const": 11 }, "stage": { "const": "controller_restart_recovery" } } }, { "not": { "required": ["export"] } }] },
    "check12": { "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "sequence": { "const": 12 }, "stage": { "const": "runner_restart_recovery" } } }, { "not": { "required": ["export"] } }] },
    "check13": { "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "sequence": { "const": 13 }, "stage": { "const": "prepare_capacity_zero" } } }, { "not": { "required": ["export"] } }] },
    "zeroProof": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "scenario_sha256", "activation_id", "activation_package_digest", "integrated_candidate_sha", "capacity", "admission", "controller_generation", "runner_generation", "controld_service_active", "controld_acceptance_socket_active", "controld_acceptance_socket_present"],
      "properties": {
        "schema_version": { "const": "buzz-ci-capacity-one-zero-proof/v1" },
        "scenario_sha256": { "$ref": "#/$defs/hex64" },
        "activation_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
        "activation_package_digest": { "$ref": "#/$defs/hex64" },
        "integrated_candidate_sha": { "$ref": "#/$defs/gitOid" },
        "capacity": { "const": 0 }, "admission": { "const": "closed" },
        "controller_generation": { "type": "integer", "minimum": 1 },
        "runner_generation": { "type": "integer", "minimum": 1 },
        "controld_service_active": { "const": false },
        "controld_acceptance_socket_active": { "const": false },
        "controld_acceptance_socket_present": { "const": false }
      }
    },
    "zeroRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "operation", "operation_id", "scenario_sha256", "activation_id", "activation_package_digest", "integrated_candidate_sha", "failed_stage"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 14, "maximum": 15 },
        "operation": { "enum": ["finalize_capacity_zero", "prove_capacity_zero"] },
        "operation_id": { "$ref": "#/$defs/hex64" },
        "scenario_sha256": { "$ref": "#/$defs/hex64" },
        "activation_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
        "activation_package_digest": { "$ref": "#/$defs/hex64" },
        "integrated_candidate_sha": { "$ref": "#/$defs/gitOid" },
        "failed_stage": { "$ref": "#/$defs/stage" },
        "final_response_sha256": { "$ref": "#/$defs/hex64" },
        "expected_controller_generation": { "type": "integer", "minimum": 1 },
        "expected_runner_generation": { "type": "integer", "minimum": 1 }
      }
    },
    "passZeroRequest": {
      "allOf": [{ "$ref": "#/$defs/zeroRequest" }, {
        "required": ["final_response_sha256", "expected_controller_generation", "expected_runner_generation"],
        "properties": { "failed_stage": { "const": "prepare_capacity_zero" } }
      }]
    },
    "zeroResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "controller_receipt_sha256", "proof"],
      "properties": {
        "operation_id": { "$ref": "#/$defs/hex64" },
        "controller_receipt_sha256": { "$ref": "#/$defs/hex64" },
        "proof": { "$ref": "#/$defs/zeroProof" }
      }
    },
    "zeroPhase": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "operation", "outcome", "attempts", "request_sha256", "response_sha256", "request", "response"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 14, "maximum": 15 },
        "operation": { "enum": ["finalize_capacity_zero", "prove_capacity_zero"] },
        "outcome": { "const": "pass" },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 2 },
        "request_sha256": { "$ref": "#/$defs/hex64" },
        "response_sha256": { "$ref": "#/$defs/hex64" },
        "request": { "$ref": "#/$defs/zeroRequest" },
        "response": { "$ref": "#/$defs/zeroResponse" }
      }
    },
    "zeroPhase14": { "allOf": [{ "$ref": "#/$defs/zeroPhase" }, { "properties": { "sequence": { "const": 14 }, "operation": { "const": "finalize_capacity_zero" }, "request": { "allOf": [{ "$ref": "#/$defs/zeroRequest" }, { "properties": { "sequence": { "const": 14 }, "operation": { "const": "finalize_capacity_zero" } } }] } } }] },
    "zeroPhase15": { "allOf": [{ "$ref": "#/$defs/zeroPhase" }, { "properties": { "sequence": { "const": 15 }, "operation": { "const": "prove_capacity_zero" }, "request": { "allOf": [{ "$ref": "#/$defs/zeroRequest" }, { "properties": { "sequence": { "const": 15 }, "operation": { "const": "prove_capacity_zero" } } }] } } }] },
    "zeroTransition": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "outcome", "attempts", "phases", "zero_proof"],
      "properties": {
        "schema_version": { "const": "buzz-ci-capacity-one-zero-transition/v1" },
        "outcome": { "const": "pass" },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 2 },
        "phases": { "type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{ "$ref": "#/$defs/zeroPhase14" }, { "$ref": "#/$defs/zeroPhase15" }], "items": false },
        "zero_proof": { "$ref": "#/$defs/zeroProof" }
      }
    },
    "passZeroTransition": {
      "allOf": [{ "$ref": "#/$defs/zeroTransition" }, { "properties": { "phases": {
        "prefixItems": [
          { "allOf": [{ "$ref": "#/$defs/zeroPhase14" }, { "properties": { "request": { "$ref": "#/$defs/passZeroRequest" } } }] },
          { "allOf": [{ "$ref": "#/$defs/zeroPhase15" }, { "properties": { "request": { "$ref": "#/$defs/passZeroRequest" } } }] }
        ]
      } } }]
    },
    "failure": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "code", "message"],
      "properties": {
        "stage": { "$ref": "#/$defs/stage" },
        "code": { "enum": ["driver_failure", "driver_binding_mismatch", "missing_evidence", "ambiguous_evidence", "identity_mismatch", "invalid_transition", "integrity_mismatch"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}
