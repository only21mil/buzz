{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buzz.dev/schemas/native-ci/runner-config-v2.json",
  "title": "Buzz CI runner configuration v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "controld_uid", "controld_gid", "mode"],
  "properties": {
    "schema_version": { "const": 2 },
    "controld_uid": { "$ref": "#/$defs/nonzeroU32" },
    "controld_gid": { "$ref": "#/$defs/nonzeroU32" },
    "mode": { "enum": ["dormant", "v2_proxy"] },
    "execd_socket": { "const": "/run/buzzci/execd.sock" },
    "execd_uid": { "const": 0 },
    "execd_gid": { "const": 0 },
    "replay_journal": { "const": "/var/lib/buzzci/runner/v2-replay.json" },
    "connect_timeout_millis": { "type": "integer", "minimum": 1, "maximum": 30000 },
    "io_timeout_millis": { "type": "integer", "minimum": 1, "maximum": 30000 },
    "transport_attempts": { "type": "integer", "minimum": 1, "maximum": 5 },
    "retry_delay_millis": { "type": "integer", "minimum": 0, "maximum": 5000 },
    "lane_manifest_digest": { "$ref": "#/$defs/sha256" },
    "lane_epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "admission_key_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "isolation_profile_digest": { "$ref": "#/$defs/sha256" },
    "audience_digest": { "$ref": "#/$defs/sha256" }
  },
  "oneOf": [
    {
      "properties": { "mode": { "const": "dormant" } },
      "not": { "anyOf": [
        { "required": ["execd_socket"] },
        { "required": ["replay_journal"] },
        { "required": ["lane_manifest_digest"] }
      ] }
    },
    {
      "properties": { "mode": { "const": "v2_proxy" } },
      "required": [
        "execd_socket", "execd_uid", "execd_gid", "replay_journal",
        "connect_timeout_millis", "io_timeout_millis", "transport_attempts",
        "retry_delay_millis", "lane_manifest_digest", "lane_epoch",
        "admission_key_generation", "isolation_profile_digest", "audience_digest"
      ]
    }
  ],
  "$defs": {
    "nonzeroU32": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "sha256": { "type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$" }
  }
}
