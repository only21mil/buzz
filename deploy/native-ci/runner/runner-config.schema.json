{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buzz.dev/schemas/native-ci/runner-config-v1.json",
  "title": "Buzz CI runner configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "controld_uid"],
  "properties": {
    "schema_version": { "const": 1 },
    "controld_uid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_pubkey",
        "manifest_verification_key",
        "relay_signer",
        "broker_socket",
        "broker_uid",
        "executor_program",
        "evidence_directory",
        "journal_directory",
        "max_argv_items",
        "max_argv_bytes",
        "max_environment_items",
        "max_environment_bytes",
        "max_output_bytes"
      ],
      "properties": {
        "owner_pubkey": { "$ref": "#/$defs/lowerHex64" },
        "manifest_verification_key": { "$ref": "#/$defs/lowerHex64" },
        "relay_signer": { "$ref": "#/$defs/lowerHex64" },
        "broker_socket": { "const": "/run/buzzci/execd.sock" },
        "broker_uid": { "const": 0 },
        "executor_program": { "type": "string", "pattern": "^/[^\\u0000]+$" },
        "evidence_directory": { "const": "/var/lib/buzzci/runner/evidence" },
        "journal_directory": { "const": "/var/lib/buzzci/runner/journal" },
        "max_argv_items": { "type": "integer", "minimum": 1, "maximum": 256 },
        "max_argv_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "max_environment_items": { "type": "integer", "minimum": 1, "maximum": 256 },
        "max_environment_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "max_output_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 }
      }
    }
  },
  "$defs": {
    "lowerHex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
