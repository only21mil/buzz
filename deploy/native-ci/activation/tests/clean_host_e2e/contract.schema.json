{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buzz.dev/schemas/native-ci/clean-host-e2e-contract-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_root", "candidate_sha", "image", "image_id", "state", "scenario", "packages"],
  "properties": {
    "schema_version": {"const": "buzz-ci-clean-host-e2e-contract/v1"},
    "candidate_root": {"type": "string", "minLength": 1},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$", "not": {"pattern": "^0+$"}},
    "image": {"type": "string", "minLength": 1, "maxLength": 255},
    "image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "state": {"type": "string", "minLength": 1},
    "scenario": {"$ref": "#/$defs/input"},
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "controld", "keyholder", "execd", "activation"],
      "properties": {
        "runner": {"$ref": "#/$defs/input"},
        "controld": {"$ref": "#/$defs/input"},
        "keyholder": {"$ref": "#/$defs/input"},
        "execd": {"$ref": "#/$defs/input"},
        "activation": {"$ref": "#/$defs/input"}
      }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
